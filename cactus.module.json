{
  "name": "unified-inbox",
  "version": "0.1.40",
  "tablePrefix": "uin_",
  "description": "Every conversation with every customer and supplier in one place - email, live chat, contact form, calls and texts - with your own records beside them.",
  "requiresCoreVersion": "0.5.1470",
  "requiresModules": [],
  "permissions": [
    "unifiedinbox.view",
    "unifiedinbox.reply",
    "unifiedinbox.manage"
  ],
  "navEntries": [],
  "settingsTabs": [
    {
      "id": "unified-inbox",
      "label": "Unified Inbox",
      "permission": "unifiedinbox.manage",
      "import": "./components/admin/SettingsTab",
      "component": "UnifiedInboxSettingsTab"
    },
    {
      "id": "unified-inbox-purchase-orders-sender",
      "label": "Sending address",
      "permission": "unifiedinbox.manage",
      "host": "purchase-orders.settings-emails",
      "import": "./components/admin/ModuleSenderPanel",
      "component": "PurchaseOrdersSenderPanel"
    },
    {
      "id": "unified-inbox-shop-sender",
      "label": "Sending address",
      "permission": "unifiedinbox.manage",
      "host": "shop.settings-notifications",
      "import": "./components/admin/ModuleSenderPanel",
      "component": "ShopSenderPanel"
    }
  ],
  "extensionPoints": [
    {
      "point": "core.inbox-tabs",
      "id": "unified-inbox",
      "label": "Unified Inbox",
      "order": 5,
      "permission": "unifiedinbox.view",
      "import": "./components/admin/InboxPanel",
      "component": "UnifiedInboxPanel"
    },
    {
      "point": "core.media-usage-providers",
      "id": "unified-inbox",
      "import": "./lib/media-usage-provider",
      "component": "unifiedInboxMediaUsageProvider"
    },
    {
      "point": "core.outbound-email-identity",
      "id": "unified-inbox",
      "serverOnly": true,
      "import": "./lib/outbound-identity",
      "component": "unifiedInboxOutboundIdentity"
    }
  ],
  "consumesConversationProviders": true,
  "requiredEnvVars": [
    {
      "name": "ENCRYPTION_KEY",
      "required": true
    },
    {
      "name": "CRON_SECRET",
      "required": false
    }
  ],
  "cookieCategories": [],
  "cronJobs": [
    {
      "path": "/api/m/unified-inbox/cron/sync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/m/unified-inbox/cron/housekeeping",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/m/unified-inbox/cron/scheduled-send",
      "schedule": "*/5 * * * *"
    }
  ],
  "teardown": [
    "uin_attachments",
    "uin_delivery_events",
    "uin_messages",
    "uin_events",
    "uin_record_links",
    "uin_processed_messages",
    "uin_sync_state",
    "uin_settings",
    "uin_outbound_uploads",
    "uin_drafts",
    "uin_threads",
    "uin_inbox_access",
    "uin_webhook_deliveries",
    "uin_webhooks",
    "uin_module_senders",
    "uin_user_default_inbox",
    "uin_inboxes",
    "uin_connections",
    "uin_person_merges",
    "uin_person_identities",
    "uin_people",
    "uin_organisations"
  ]
}
